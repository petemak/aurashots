# /etc/aurashots/prod.env (root:aurashots 0640). Different TOKEN_PEPPER from staging. PUBLIC_BASE_URL must match the web build.
APP_ENV=prod
PORT=8080
PUBLIC_BASE_URL=https://aura-shots.com
DATA_DIR=/var/lib/aurashots/prod
UPLOAD_DIR=/var/lib/aurashots/prod/uploads
BACKUP_DIR=/var/lib/aurashots/prod/backups
WEB_ROOT=dist/web
TRUSTED_PROXY_HOPS=1
COOKIE_SECURE=true
LOG_LEVEL=info
# Generated by provision.sh on first run; do not change after launch.
TOKEN_PEPPER=GENERATED
# Optional: leave commented until set (an empty value is not the same as unset). Email: site works with it queued.
# OWNER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
