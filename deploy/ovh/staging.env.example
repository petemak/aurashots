# /etc/aurashots/staging.env (root:aurashots 0640). Variable names per resources/config.edn and architecture.md section 8.
APP_ENV=staging
PORT=8081
PUBLIC_BASE_URL=https://CHANGE-ME.vps.ovh.net
# Staging sitemap lists the production origin only; leave unset until the domain exists.
# PRODUCTION_BASE_URL=
DATA_DIR=/var/lib/aurashots/staging
UPLOAD_DIR=/var/lib/aurashots/staging/uploads
BACKUP_DIR=/var/lib/aurashots/staging/backups
WEB_ROOT=dist/web
TRUSTED_PROXY_HOPS=1
COOKIE_SECURE=true
LOG_LEVEL=info
# Generated by provision.sh on first run; do not change after launch.
TOKEN_PEPPER=GENERATED
# Optional: leave commented until set (an empty value is not the same as unset). Email: site works with it queued.
# OWNER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
