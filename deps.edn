{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        integrant/integrant {:mvn/version "1.0.1"}
        aero/aero {:mvn/version "1.1.6"}
        io.pedestal/pedestal.service {:mvn/version "0.8.2"}
        io.pedestal/pedestal.jetty {:mvn/version "0.8.2"}
        metosin/malli {:mvn/version "0.20.3"}
        metosin/jsonista {:mvn/version "1.0.2"}
        com.taoensso/timbre {:mvn/version "6.8.0"}
        org.datalevin/datalevin-embedded {:mvn/version "1.2.10"}
        buddy/buddy-hashers {:mvn/version "2.0.167"}
        org.eclipse.angus/angus-mail {:mvn/version "2.0.3"}
        com.twelvemonkeys.imageio/imageio-webp {:mvn/version "3.12.0"}}
 :aliases
 {:dev {:extra-paths ["test"]
        :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  :run {:main-opts ["-m" "aurashots.system"]
        :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"]}
  :build {:paths ["scripts/backend"]
          :deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                    "--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner"]}}}
